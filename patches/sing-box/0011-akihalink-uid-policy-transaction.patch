index 00000000..3f24c187
--- /dev/null
+++ b/common/ebpf/uid_policy_status_test.go
@@ -0,0 +1,47 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import "testing"
+
+func TestUIDPolicyFingerprintIsOrderIndependent(t *testing.T) {
+	first := CgroupPolicy{ExcludeUID: []UIDRange{
+		{Start: 20_123, End: 20_123},
+		{Start: 10_123, End: 10_123},
+	}}
+	second := CgroupPolicy{ExcludeUID: []UIDRange{
+		{Start: 10_123, End: 10_123},
+		{Start: 20_123, End: 20_123},
+	}}
+	if UIDPolicyFingerprint(first) != UIDPolicyFingerprint(second) {
+		t.Fatal("UID policy fingerprint changed with input order")
+	}
+}
+
+func TestUIDPolicyFingerprintCoversCombinedSemantics(t *testing.T) {
+	exclude := CgroupPolicy{ExcludeUID: []UIDRange{{Start: 10_123, End: 10_123}}}
+	include := CgroupPolicy{
+		IncludeUIDConfigured: true,
+		IncludeUID:           []UIDRange{{Start: 10_123, End: 10_123}},
+	}
+	if UIDPolicyFingerprint(exclude) == UIDPolicyFingerprint(include) {
+		t.Fatal("UID policy fingerprint ignored default bypass semantics")
+	}
+
+	withExcludedInclude := include
+	withExcludedInclude.ExcludeUID = []UIDRange{{Start: 10_123, End: 10_123}}
+	if UIDPolicyFingerprint(include) == UIDPolicyFingerprint(withExcludedInclude) {
+		t.Fatal("UID policy fingerprint ignored include/exclude precedence")
+	}
+}
+
+func TestUIDPolicyTrackedUIDsIgnoreRanges(t *testing.T) {
+	tracked := uidPolicyTrackedUIDs([]UIDRange{
+		{Start: 10_123, End: 10_123},
+		{Start: 10_123, End: 10_123},
+		{Start: 20_000, End: 20_010},
+	})
+	if len(tracked) != 1 || tracked[0] != 10_123 {
+		t.Fatalf("unexpected tracked UIDs: %v", tracked)
+	}
+}
