+func (control *uidPolicyControl) statusFor(i *Inbound, configured []ECommon.UIDRange) (uidPolicyStatus, error) {
+	configuredPolicy := i.cgroupPolicy
+	configuredPolicy.ExcludeUID = append([]ECommon.UIDRange(nil), configured...)
+	status := uidPolicyStatus{
+		Generation:            control.generation,
+		ConfiguredFingerprint: ECommon.UIDPolicyFingerprint(configuredPolicy),
+		Known:                 control.known,
+	}
+	backend := i.cgroupBackendInstance()
+	if backend == nil {
+		status.Known = false
+		return status, errors.New("eBPF backend is not available")
+	}
+	live, err := backend.UIDPolicySnapshot()
+	if err != nil {
+		status.Known = false
+		return status, err
+	}
