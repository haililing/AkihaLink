+func readUIDPolicyMap(mapFD int) ([]uidLPMKey, error) {
+	if mapFD < 0 {
+		return nil, errBackendClosed
+	}
+	entries := make([]uidLPMKey, 0)
+	var current uidLPMKey
+	var currentPointer unsafe.Pointer
+	for {
+		var next uidLPMKey
+		err := nextMapKey(mapFD, currentPointer, unsafe.Pointer(&next))
+		if errors.Is(err, unix.ENOENT) {
+			return entries, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		var value uint8
+		if err = lookupMap(mapFD, unsafe.Pointer(&next), unsafe.Pointer(&value)); err != nil {
+			return nil, err
+		}
+		entries = append(entries, next)
+		current = next
+		currentPointer = unsafe.Pointer(&current)
+	}
+}
+
+func populateUIDBypassCounterMap(mapFD int, uids []uint32) error {
+	return replaceUIDBypassCounterMap(mapFD, nil, uids)
+}
+
+func replaceUIDBypassCounterMap(
+	mapFD int,
+	current map[uint32]uidBypassCounter,
+	nextUIDs []uint32,
+) error {
+	if mapFD < 0 {
+		return errBackendClosed
+	}
+	next := make(map[uint32]struct{}, len(nextUIDs))
+	for _, uid := range nextUIDs {
+		next[uid] = struct{}{}
+	}
+	added := make([]uint32, 0, len(next))
+	for uid := range next {
+		if _, exists := current[uid]; exists {
+			continue
+		}
+		key := uid
+		value := uidBypassCounter{}
+		if err := updateMapWithFlags(mapFD, unsafe.Pointer(&key), unsafe.Pointer(&value), bpfNoExist); err != nil {
+			if errors.Is(err, unix.EEXIST) {
+				continue
+			}
+			return policyUpdateError(err, rollbackUIDBypassCounterMap(mapFD, added, nil))
+		}
+		added = append(added, uid)
+	}
+	removed := make(map[uint32]uidBypassCounter)
+	for uid, counter := range current {
+		if _, keep := next[uid]; keep {
+			continue
+		}
+		key := uid
+		if err := deleteMap(mapFD, unsafe.Pointer(&key)); err != nil {
+			if errors.Is(err, unix.ENOENT) {
+				continue
+			}
+			return policyUpdateError(err, rollbackUIDBypassCounterMap(mapFD, added, removed))
+		}
+		removed[uid] = counter
+	}
+	return nil
+}
+
+func readUIDBypassCounterMap(mapFD int) (map[uint32]uidBypassCounter, error) {
+	if mapFD < 0 {
+		return nil, errBackendClosed
+	}
+	counters := make(map[uint32]uidBypassCounter)
+	var current uint32
+	var currentPointer unsafe.Pointer
+	for {
+		var next uint32
+		err := nextMapKey(mapFD, currentPointer, unsafe.Pointer(&next))
+		if errors.Is(err, unix.ENOENT) {
+			return counters, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		var counter uidBypassCounter
+		if err = lookupMap(mapFD, unsafe.Pointer(&next), unsafe.Pointer(&counter)); err != nil {
+			return nil, err
+		}
+		counters[next] = counter
+		current = next
+		currentPointer = unsafe.Pointer(&current)
+	}
+}
+
+func rollbackUIDBypassCounterMap(
+	mapFD int,
+	added []uint32,
+	removed map[uint32]uidBypassCounter,
+) error {
+	var rollbackErr error
+	for uid, counter := range removed {
+		key := uid
+		value := counter
+		if err := updateMap(mapFD, unsafe.Pointer(&key), unsafe.Pointer(&value)); err != nil {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	for _, uid := range added {
+		key := uid
+		if err := deleteMap(mapFD, unsafe.Pointer(&key)); err != nil && !errors.Is(err, unix.ENOENT) {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	return rollbackErr
+}
