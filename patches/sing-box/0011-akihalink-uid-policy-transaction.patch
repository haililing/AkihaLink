+func (b *CgroupBackend) UIDPolicySnapshot() (UIDPolicyMapSnapshot, error) {
+	if b == nil {
+		return UIDPolicyMapSnapshot{}, errBackendClosed
+	}
+	b.access.RLock()
+	defer b.access.RUnlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return UIDPolicyMapSnapshot{}, err
+	}
+	entries, err := readUIDPolicyMap(b.uidPolicyMapFD)
+	if err != nil {
+		return UIDPolicyMapSnapshot{}, E.Cause(err, "read UID policy eBPF map")
+	}
+	snapshot := UIDPolicyMapSnapshot{
+		LiveFingerprint: uidPolicyEntriesFingerprint(entries, b.uidDefaultBypass),
+	}
+	counters, err := readUIDBypassCounterMap(b.uidBypassCounterMapFD)
+	if err != nil {
+		return UIDPolicyMapSnapshot{}, E.Cause(err, "read UID bypass counter eBPF map")
+	}
+	snapshot.EffectiveUIDs = len(counters)
+	for _, counter := range counters {
+		snapshot.TCPBypassHits += counter.TCP
+		snapshot.UDPBypassHits += counter.UDP
+	}
+	return snapshot, nil
+}
