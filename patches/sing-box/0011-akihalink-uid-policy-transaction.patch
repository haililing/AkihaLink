+type uidBypassCounter struct {
+	TCP uint64
+	UDP uint64
+}
+
+func UIDPolicyFingerprint(policy CgroupPolicy) string {
+	entries, defaultBypass, err := compileUIDPolicy(policy)
+	if err != nil {
+		return ""
+	}
+	return uidPolicyEntriesFingerprint(entries, defaultBypass)
+}
+
+func uidPolicyEntriesFingerprint(entries []uidLPMKey, defaultBypass bool) string {
+	sortedEntries := append([]uidLPMKey(nil), entries...)
+	sort.Slice(sortedEntries, func(i, j int) bool {
+		if sortedEntries[i].PrefixLength != sortedEntries[j].PrefixLength {
+			return sortedEntries[i].PrefixLength < sortedEntries[j].PrefixLength
+		}
+		return binary.BigEndian.Uint32(sortedEntries[i].UID[:]) < binary.BigEndian.Uint32(sortedEntries[j].UID[:])
+	})
+	hash := sha256.New()
+	if defaultBypass {
+		_, _ = hash.Write([]byte{1})
+	} else {
+		_, _ = hash.Write([]byte{0})
+	}
+	var raw [8]byte
+	for _, entry := range sortedEntries {
+		binary.BigEndian.PutUint32(raw[:4], entry.PrefixLength)
+		copy(raw[4:], entry.UID[:])
+		_, _ = hash.Write(raw[:])
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func uidPolicyTrackedUIDs(uidRanges []UIDRange) []uint32 {
+	tracked := make(map[uint32]struct{})
+	for _, uidRange := range uidRanges {
+		if uidRange.Start == uidRange.End {
+			tracked[uidRange.Start] = struct{}{}
+		}
+	}
+	values := make([]uint32, 0, len(tracked))
+	for uid := range tracked {
+		values = append(values, uid)
+	}
+	sort.Slice(values, func(i, j int) bool { return values[i] < values[j] })
+	return values
+}
