+func (w *udpPacketWriter) WritePacketBatch(buffers []*buf.Buffer, destinations []M.Socksaddr) error {
+	defer buf.ReleaseMulti(buffers)
+	if len(buffers) == 0 || len(buffers) != len(destinations) {
+		return os.ErrInvalid
+	}
+	start := 0
+	for start < len(buffers) {
+		firstBinding, loaded := w.clientState.redirectBinding(destinations[start].AddrPort())
+		if !loaded {
+			return E.New("missing UDP redirect binding for ", destinations[start])
+		}
+		ipv6 := firstBinding.address.Is6()
+		payloads := make([][]byte, 0, len(buffers)-start)
+		packetInfos := make([][]byte, 0, len(buffers)-start)
+		end := start
+		for end < len(buffers) {
+			binding, exists := w.clientState.redirectBinding(destinations[end].AddrPort())
+			if !exists {
+				return E.New("missing UDP redirect binding for ", destinations[end])
+			}
+			if binding.address.Is6() != ipv6 {
+				break
+			}
+			payloads = append(payloads, buffers[end].Bytes())
+			packetInfos = append(packetInfos, binding.packetInfo)
+			end++
+		}
+		if err := w.inbound.listeners.writeUDPBatch(payloads, packetInfos, w.client, ipv6); err != nil {
+			return err
+		}
+		start = end
+	}
+	return nil
+}
