+
+func (s *internalListenerSet) writeUDPBatch(
+	payloads [][]byte,
+	packetInfos [][]byte,
+	client netip.AddrPort,
+	ipv6 bool,
+) error {
+	udpListener := s.udp(ipv6)
+	if udpListener == nil {
+		addressFamily := "IPv4"
+		if ipv6 {
+			addressFamily = "IPv6"
+		}
+		return E.New(addressFamily, " eBPF UDP redirect listener is unavailable")
+	}
+	destinations := make([]netip.AddrPort, len(payloads))
+	for index := range destinations {
+		destinations[index] = client
+	}
+	return udpListener.WriteMsgUDPAddrPortBatch(payloads, packetInfos, destinations)
+}
