diff --git a/common/ebpf/uid_policy_live.go b/common/ebpf/uid_policy_live.go
new file mode 100644
index 00000000..8070540d
--- /dev/null
+++ b/common/ebpf/uid_policy_live.go
@@ -0,0 +1,184 @@
+//go:build with_ebpf && (linux || android) && cgo
+
+package ebpf
+
+import (
+	"errors"
+	"slices"
+	"unsafe"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"golang.org/x/sys/unix"
+)
+
+// ReplaceExcludeUIDPolicy updates the already attached cgroup eBPF policy.
+// Adding entries before removing stale entries avoids a window where a newly
+// excluded application could be redirected by the old policy.
+func (b *CgroupBackend) ReplaceExcludeUIDPolicy(uidRanges []UIDRange) error {
+	if b == nil {
+		return errBackendClosed
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return err
+	}
+	nextPolicy := cloneCgroupPolicy(b.uidPolicy)
+	nextPolicy.ExcludeUID = slices.Clone(uidRanges)
+	entries, defaultBypass, err := compileUIDPolicy(nextPolicy)
+	if err != nil {
+		return err
+	}
+	if defaultBypass != b.uidDefaultBypass {
+		return E.New("live UID policy update changed default bypass semantics")
+	}
+	if slices.Equal(entries, b.uidPolicyEntries) {
+		b.uidPolicy = nextPolicy
+		return nil
+	}
+	if err = replaceUIDPolicyMap(b.uidPolicyMapFD, b.uidPolicyEntries, entries); err != nil {
+		if policyRollbackFailed(err) {
+			return E.Errors(err, b.health.invalidate("cgroup", "UID policy"))
+		}
+		return err
+	}
+	b.uidPolicyEntries = slices.Clone(entries)
+	b.uidPolicy = nextPolicy
+	return nil
+}
+
+func cloneCgroupPolicy(policy CgroupPolicy) CgroupPolicy {
+	policy.IncludeUID = slices.Clone(policy.IncludeUID)
+	policy.ExcludeUID = slices.Clone(policy.ExcludeUID)
+	return policy
+}
+
+func replaceUIDPolicyMap(mapFD int, currentEntries []uidLPMKey, nextEntries []uidLPMKey) error {
+	if mapFD < 0 {
+		return errBackendClosed
+	}
+	current := make(map[uidLPMKey]struct{}, len(currentEntries))
+	for _, entry := range currentEntries {
+		current[entry] = struct{}{}
+	}
+	next := make(map[uidLPMKey]struct{}, len(nextEntries))
+	for _, entry := range nextEntries {
+		next[entry] = struct{}{}
+	}
+	additions := make([]uidLPMKey, 0, len(next))
+	for entry := range next {
+		if _, exists := current[entry]; !exists {
+			additions = append(additions, entry)
+		}
+	}
+	removals := make([]uidLPMKey, 0, len(current))
+	for entry := range current {
+		if _, exists := next[entry]; !exists {
+			removals = append(removals, entry)
+		}
+	}
+	if len(additions) == 0 && len(removals) == 0 {
+		return nil
+	}
+	added, err := addUIDPolicyEntries(mapFD, additions)
+	if err != nil {
+		return policyUpdateError(err, rollbackUIDPolicyMap(mapFD, added, nil))
+	}
+	removed, err := removeUIDPolicyEntries(mapFD, removals)
+	if err != nil {
+		return policyUpdateError(err, rollbackUIDPolicyMap(mapFD, added, removed))
+	}
+	return nil
+}
+
+func addUIDPolicyEntries(mapFD int, entries []uidLPMKey) ([]uidLPMKey, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	values := make([]uint8, len(entries))
+	for index := range values {
+		values[index] = 1
+	}
+	processed, err := updateMapBatch(
+		mapFD,
+		unsafe.Pointer(&entries[0]),
+		unsafe.Pointer(&values[0]),
+		uint32(len(entries)),
+		unsafe.Sizeof(entries[0]),
+		unsafe.Sizeof(values[0]),
+		bpfNoExist,
+		&uidPolicyUpdateBatchSupport,
+	)
+	if processed > uint32(len(entries)) {
+		return nil, E.New("invalid eBPF batch update count: ", processed)
+	}
+	added := slices.Clone(entries[:processed])
+	if err == nil {
+		return added, nil
+	}
+	if !errors.Is(err, unix.EEXIST) {
+		return added, err
+	}
+	value := uint8(1)
+	for _, entry := range entries[processed:] {
+		err = updateMapWithFlags(mapFD, unsafe.Pointer(&entry), unsafe.Pointer(&value), bpfNoExist)
+		if errors.Is(err, unix.EEXIST) {
+			continue
+		}
+		if err != nil {
+			return added, err
+		}
+		added = append(added, entry)
+	}
+	return added, nil
+}
+
+func removeUIDPolicyEntries(mapFD int, entries []uidLPMKey) ([]uidLPMKey, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	processed, err := deleteMapBatch(
+		mapFD,
+		unsafe.Pointer(&entries[0]),
+		uint32(len(entries)),
+		unsafe.Sizeof(entries[0]),
+		&uidPolicyDeleteBatchSupport,
+	)
+	if processed > uint32(len(entries)) {
+		return nil, E.New("invalid eBPF batch delete count: ", processed)
+	}
+	removed := slices.Clone(entries[:processed])
+	if err == nil {
+		return removed, nil
+	}
+	if !errors.Is(err, unix.ENOENT) {
+		return removed, err
+	}
+	for _, entry := range entries[processed:] {
+		err = deleteMap(mapFD, unsafe.Pointer(&entry))
+		if errors.Is(err, unix.ENOENT) {
+			continue
+		}
+		if err != nil {
+			return removed, err
+		}
+		removed = append(removed, entry)
+	}
+	return removed, nil
+}
+
+func rollbackUIDPolicyMap(mapFD int, added, removed []uidLPMKey) error {
+	var rollbackErr error
+	value := uint8(1)
+	for _, entry := range removed {
+		if err := updateMap(mapFD, unsafe.Pointer(&entry), unsafe.Pointer(&value)); err != nil {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	for _, entry := range added {
+		if err := deleteMap(mapFD, unsafe.Pointer(&entry)); err != nil && !errors.Is(err, unix.ENOENT) {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	return rollbackErr
+}
