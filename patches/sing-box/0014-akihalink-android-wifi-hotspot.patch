+++ b/protocol/ebpf/android_tethering_test.go
@@ -0,0 +1,90 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestNormalizeAndroidWiFiTethering(t *testing.T) {
+	options, err := normalizeSharedNetworkOptionsForPlatform("android", option.EBPFSharedNetworkOptions{
+		Enabled:          true,
+		AndroidTethering: androidTetheringWiFi,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if options.AndroidTethering != androidTetheringWiFi || len(options.IncludeInterface) != 0 {
+		t.Fatalf("unexpected normalized options: %+v", options)
+	}
+	for name, testOptions := range map[string]option.EBPFSharedNetworkOptions{
+		"non_android": {Enabled: true, AndroidTethering: androidTetheringWiFi},
+		"mixed_selection": {
+			Enabled: true, AndroidTethering: androidTetheringWiFi, IncludeInterface: []string{"ap0"},
+		},
+	} {
+		platform := "android"
+		if name == "non_android" {
+			platform = "linux"
+		}
+		if _, err = normalizeSharedNetworkOptionsForPlatform(platform, testOptions); err == nil {
+			t.Fatalf("expected %s to be rejected", name)
+		}
+	}
+}
+
+func TestParseAndroidWiFiTetheringStateAOSP(t *testing.T) {
+	output := `
+Tethering:
+  Configuration:
+    tetherableWifiRegexs: [wlan\d+, ap\d+]
+  Tether state:
+    wlan0 - AvailableState - lastError = 0
+    wlan1 - TetheredState - lastError = 0
+    rndis0 - TetheredState - lastError = 0
+`
+	interfaces, err := parseAndroidWiFiTetheringState(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(interfaces, []string{"wlan1"}) {
+		t.Fatalf("unexpected interfaces: %v", interfaces)
+	}
+}
+
+func TestParseAndroidWiFiTetheringStateVendorFormats(t *testing.T) {
+	output := `
+ mTetherableWifiRegexs=[softap[0-9]+, wlan[0-9]+]
+ InterfaceStateMachine{iface=softap2, currentState=TetheredState}
+ InterfaceStateMachine{iface=wlan0, currentState=AvailableState}
+ wlan1: TetheredState
+ p2p0 - TetheredState - lastError = 0
+`
+	interfaces, err := parseAndroidWiFiTetheringState(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(interfaces, []string{"softap2", "wlan1"}) {
+		t.Fatalf("unexpected interfaces: %v", interfaces)
+	}
+}
+
+func TestParseAndroidWiFiTetheringStateRequiresSystemRegexes(t *testing.T) {
+	if _, err := parseAndroidWiFiTetheringState("wlan1 - TetheredState - lastError = 0"); err == nil {
+		t.Fatal("expected missing Wi-Fi regexes to be rejected")
+	}
+}
+
+func TestCappedAndroidTetheringOutput(t *testing.T) {
+	writer := new(cappedOutput)
+	payload := make([]byte, androidTetheringOutputLimit+1)
+	if count, err := writer.Write(payload); err != nil || count != len(payload) {
+		t.Fatalf("unexpected capped write: count=%d error=%v", count, err)
+	}
+	if !writer.overflow || writer.buffer.Len() != androidTetheringOutputLimit {
+		t.Fatalf("output cap was not enforced: size=%d overflow=%v", writer.buffer.Len(), writer.overflow)
+	}
+}
