diff --git a/protocol/ebpf/android_tethering.go b/protocol/ebpf/android_tethering.go
new file mode 100644
index 00000000..7d8544ae
--- /dev/null
+++ b/protocol/ebpf/android_tethering.go
@@ -0,0 +1,163 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+const (
+	androidTetheringWiFi          = "wifi"
+	androidTetheringReadTimeout   = 2 * time.Second
+	androidTetheringOutputLimit   = 64 << 10
+	androidTetheringFailureLimit  = 3
+	androidTetheringRefreshPeriod = 30 * time.Second
+)
+
+var (
+	wifiRegexLine             = regexp.MustCompile(`(?i)(?:m?TetherableWifiRegexs)\s*[:=]\s*\[(.*)\]`)
+	tetheredInterfacePatterns = []*regexp.Regexp{
+		regexp.MustCompile(`^\s*([A-Za-z0-9_.-]{1,15})\s*-\s*TetheredState(?:\s*-|\s*$)`),
+		regexp.MustCompile(`^\s*([A-Za-z0-9_.-]{1,15})\s*[:=]\s*TetheredState\s*$`),
+		regexp.MustCompile(`(?i)(?:iface|interface)\s*[=:]\s*([A-Za-z0-9_.-]{1,15}).*(?:state|currentState)\s*[=:]\s*TetheredState`),
+	}
+	validSharedInterfaceName = regexp.MustCompile(`^[A-Za-z0-9_.-]{1,15}$`)
+)
+
+type cappedOutput struct {
+	buffer   bytes.Buffer
+	overflow bool
+}
+
+func (w *cappedOutput) Write(p []byte) (int, error) {
+	remaining := androidTetheringOutputLimit - w.buffer.Len()
+	if remaining > 0 {
+		if len(p) < remaining {
+			remaining = len(p)
+		}
+		_, _ = w.buffer.Write(p[:remaining])
+	}
+	if len(p) > remaining {
+		w.overflow = true
+	}
+	return len(p), nil
+}
+
+type androidTetheringDiscoveryError struct{ cause error }
+
+func (e *androidTetheringDiscoveryError) Error() string { return e.cause.Error() }
+func (e *androidTetheringDiscoveryError) Unwrap() error { return e.cause }
+
+func discoverAndroidWiFiTethering(parent context.Context) ([]string, error) {
+	ctx, cancel := context.WithTimeout(parent, androidTetheringReadTimeout)
+	defer cancel()
+	output := new(cappedOutput)
+	command := exec.CommandContext(ctx, "/system/bin/dumpsys", "tethering")
+	command.Stdout = output
+	if err := command.Run(); err != nil {
+		if ctx.Err() != nil {
+			err = ctx.Err()
+		}
+		return nil, &androidTetheringDiscoveryError{fmt.Errorf("read Android tethering state: %w", err)}
+	}
+	if output.overflow {
+		return nil, &androidTetheringDiscoveryError{fmt.Errorf("Android tethering state exceeded %d bytes", androidTetheringOutputLimit)}
+	}
+	interfaces, err := parseAndroidWiFiTetheringState(output.buffer.String())
+	if err != nil {
+		return nil, &androidTetheringDiscoveryError{err}
+	}
+	return interfaces, nil
+}
+
+func parseAndroidWiFiTetheringState(output string) ([]string, error) {
+	var wifiPatterns []*regexp.Regexp
+	var tethered []string
+	scanner := bufio.NewScanner(strings.NewReader(output))
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if match := wifiRegexLine.FindStringSubmatch(line); len(match) == 2 {
+			for _, rawPattern := range strings.Split(match[1], ",") {
+				rawPattern = strings.Trim(strings.TrimSpace(rawPattern), `"'`)
+				if rawPattern == "" {
+					continue
+				}
+				pattern, err := regexp.Compile("^(?:" + rawPattern + ")$")
+				if err != nil {
+					return nil, fmt.Errorf("parse Android Wi-Fi tethering regex: %w", err)
+				}
+				wifiPatterns = append(wifiPatterns, pattern)
+			}
+		}
+		if !strings.Contains(line, "TetheredState") || strings.Contains(strings.ToLower(line), "localonly") {
+			continue
+		}
+		for _, pattern := range tetheredInterfacePatterns {
+			if match := pattern.FindStringSubmatch(line); len(match) == 2 {
+				tethered = append(tethered, match[1])
+				break
+			}
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, fmt.Errorf("scan Android tethering state: %w", err)
+	}
+	if len(wifiPatterns) == 0 {
+		return nil, fmt.Errorf("Android tethering state did not provide Wi-Fi interface regexes")
+	}
+	selected := make(map[string]struct{})
+	for _, interfaceName := range tethered {
+		if !validSharedInterfaceName.MatchString(interfaceName) {
+			continue
+		}
+		for _, pattern := range wifiPatterns {
+			if pattern.MatchString(interfaceName) {
+				selected[interfaceName] = struct{}{}
+				break
+			}
+		}
+	}
+	interfaces := make([]string, 0, len(selected))
+	for interfaceName := range selected {
+		interfaces = append(interfaces, interfaceName)
+	}
+	sort.Strings(interfaces)
+	return interfaces, nil
+}
+
+func writeAndroidHotspotState(state string) error {
+	runtimeDirectory := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDirectory == "" {
+		return nil
+	}
+	if err := os.MkdirAll(runtimeDirectory, 0o700); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(runtimeDirectory, ".hotspot-state-")
+	if err != nil {
+		return err
+	}
+	temporaryName := temporary.Name()
+	defer os.Remove(temporaryName)
+	if err = temporary.Chmod(0o600); err == nil {
+		_, err = temporary.WriteString(state + "\n")
+	}
+	closeErr := temporary.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(temporaryName, filepath.Join(runtimeDirectory, "hotspot.state"))
+}
