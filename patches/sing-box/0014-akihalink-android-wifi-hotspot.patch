+func writeSharedTCJournal(attachment *sharedTCAttachment) (string, error) {
+	runtimeDirectory := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDirectory == "" {
+		return "", nil
+	}
+	directory := filepath.Join(runtimeDirectory, "shared-network")
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return "", err
+	}
+	record := sharedTCJournal{
+		InterfaceName:         attachment.interfaceName,
+		InterfaceIndex:        attachment.interfaceIndex,
+		RouteLocalnetOriginal: 1,
+		CreatedClsact:         attachment.createdClsact,
+	}
+	if attachment.restoreRouteLocalnet {
+		record.RouteLocalnetOriginal = 0
+	}
+	content, err := json.Marshal(record)
+	if err != nil {
+		return "", err
+	}
+	path := filepath.Join(directory, fmt.Sprintf("%d.json", attachment.interfaceIndex))
+	temporary, err := os.CreateTemp(directory, ".attachment-")
+	if err != nil {
+		return "", err
+	}
+	temporaryName := temporary.Name()
+	defer os.Remove(temporaryName)
+	if err = temporary.Chmod(0o600); err == nil {
+		_, err = temporary.Write(content)
+	}
+	closeErr := temporary.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return "", err
+	}
+	if err = os.Rename(temporaryName, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
