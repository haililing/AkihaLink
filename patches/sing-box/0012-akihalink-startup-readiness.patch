index 00000000..5a18ffcb
--- /dev/null
+++ b/common/ebpf/readiness_cgo_test.go
@@ -0,0 +1,43 @@
+//go:build with_ebpf && (linux || android) && cgo
+
+package ebpf
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAtomicReadinessWrite(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "runtime", "core.ready")
+	if err := atomicReadinessWrite(path, []byte("first\n")); err != nil {
+		t.Fatal(err)
+	}
+	if err := atomicReadinessWrite(path, []byte("second\n")); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(content) != "second\n" {
+		t.Fatalf("unexpected readiness content: %q", content)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("unexpected readiness mode: %o", info.Mode().Perm())
+	}
+}
+
+func TestCurrentProcessStartTimeForReadiness(t *testing.T) {
+	startTime, err := currentProcessStartTimeForReadiness()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if startTime == "" {
+		t.Fatal("empty process start time")
+	}
+}
