new file mode 100644
index 00000000..f6c6a486
--- /dev/null
+++ b/common/ebpf/android_system_resolver_cgo_test.go
@@ -0,0 +1,49 @@
+//go:build with_ebpf && (linux || android) && cgo
+
+package ebpf
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAndroidSystemResolverIdentity(t *testing.T) {
+	procRoot := t.TempDir()
+	processRoot := filepath.Join(procRoot, "123")
+	if err := os.MkdirAll(processRoot, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	writeFixture := func(name string, content []byte) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(processRoot, name), content, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	writeFixture("status", []byte("Name:\tnetd\nUid:\t0\t0\t0\t0\n"))
+	writeFixture("cmdline", []byte("/system/bin/netd\x00"))
+	if err := os.Symlink("/system/bin/netd", filepath.Join(processRoot, "exe")); err != nil {
+		t.Fatal(err)
+	}
+	for _, testCase := range []struct {
+		threadName string
+		accepted   bool
+	}{
+		{threadName: "netd", accepted: true},
+		{threadName: "Binder:netd", accepted: true},
+		{threadName: "binder:123_4", accepted: true},
+		{threadName: "binder:456_4", accepted: false},
+		{threadName: "binder:123_worker", accepted: false},
+	} {
+		writeFixture("comm", []byte(testCase.threadName+"\n"))
+		if actual := isAndroidSystemResolverProcess(procRoot, "123"); actual != testCase.accepted {
+			t.Fatalf("thread name %q accepted=%t, want %t", testCase.threadName, actual, testCase.accepted)
+		}
+	}
+
+	writeFixture("comm", []byte("netd\n"))
+	writeFixture("status", []byte("Name:\tnetd\nUid:\t1000\t1000\t1000\t1000\n"))
+	if isAndroidSystemResolverProcess(procRoot, "123") {
+		t.Fatal("non-root netd identity was accepted")
+	}
+}
