+func TestUIDPolicyMapTransactionIntegration(t *testing.T) {
+	requireEBPFIntegration(t, "test UID policy map transactions")
+	current, _, err := compileUIDPolicy(CgroupPolicy{
+		ExcludeUID: []UIDRange{{Start: 10_123, End: 10_123}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	next, _, err := compileUIDPolicy(CgroupPolicy{
+		ExcludeUID: []UIDRange{
+			{Start: 20_123, End: 20_123},
+			{Start: 30_123, End: 30_123},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mapFD := createIntegrationMap(t, mapCreateAttr{
+		MapType:    11,
+		KeySize:    uint32(unsafe.Sizeof(uidLPMKey{})),
+		ValueSize:  1,
+		MaxEntries: 8,
+		MapFlags:   1,
+	})
+	if err = populateUIDPolicyMap(mapFD, current); err != nil {
+		t.Fatal(err)
+	}
+	if err = replaceUIDPolicyMap(mapFD, current, next); err != nil {
+		t.Fatal(err)
+	}
+	live, err := readUIDPolicyMap(mapFD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if uidPolicyEntriesFingerprint(live, false) != uidPolicyEntriesFingerprint(next, false) {
+		t.Fatalf("forward UID policy verification failed: %v", live)
+	}
+	if err = replaceUIDPolicyMap(mapFD, next, current); err != nil {
+		t.Fatal(err)
+	}
+	live, err = readUIDPolicyMap(mapFD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if uidPolicyEntriesFingerprint(live, false) != uidPolicyEntriesFingerprint(current, false) {
+		t.Fatalf("reverse UID policy verification failed: %v", live)
+	}
+}
+
+func TestUIDPolicyMapCapacityFailureRollsBackIntegration(t *testing.T) {
+	requireEBPFIntegration(t, "test UID policy map rollback")
+	current := compileUIDRanges([]UIDRange{{Start: 10_123, End: 10_123}})
+	next := compileUIDRanges([]UIDRange{
+		{Start: 20_123, End: 20_123},
+		{Start: 30_123, End: 30_123},
+	})
+	mapFD := createIntegrationMap(t, mapCreateAttr{
+		MapType:    11,
+		KeySize:    uint32(unsafe.Sizeof(uidLPMKey{})),
+		ValueSize:  1,
+		MaxEntries: 2,
+		MapFlags:   1,
+	})
+	if err := populateUIDPolicyMap(mapFD, current); err != nil {
+		t.Fatal(err)
+	}
+	if err := replaceUIDPolicyMap(mapFD, current, next); err == nil {
+		t.Fatal("expected capacity-constrained UID policy update to fail")
+	}
+	live, err := readUIDPolicyMap(mapFD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if uidPolicyEntriesFingerprint(live, false) != uidPolicyEntriesFingerprint(current, false) {
+		t.Fatalf("failed UID policy update was not rolled back: %v", live)
+	}
+}
+
+func TestUIDBypassCounterTransactionIntegration(t *testing.T) {
+	requireEBPFIntegration(t, "test UID bypass counter transactions")
+	mapFD := createIntegrationMap(t, mapCreateAttr{
+		MapType:    1,
+		KeySize:    uint32(unsafe.Sizeof(uint32(0))),
+		ValueSize:  uint32(unsafe.Sizeof(uidBypassCounter{})),
+		MaxEntries: 4,
+	})
+	if err := populateUIDBypassCounterMap(mapFD, []uint32{10_123, 20_123}); err != nil {
+		t.Fatal(err)
+	}
+	key := uint32(20_123)
+	value := uidBypassCounter{TCP: 7, UDP: 11}
+	if err := updateMap(mapFD, unsafe.Pointer(&key), unsafe.Pointer(&value)); err != nil {
+		t.Fatal(err)
+	}
+	current, err := readUIDBypassCounterMap(mapFD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = replaceUIDBypassCounterMap(mapFD, current, []uint32{20_123, 30_123}); err != nil {
+		t.Fatal(err)
+	}
+	live, err := readUIDBypassCounterMap(mapFD)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(live) != 2 || live[20_123] != value || live[30_123] != (uidBypassCounter{}) {
+		t.Fatalf("unexpected live UID counters: %v", live)
+	}
+}
+
+func createIntegrationMap(t *testing.T, attribute mapCreateAttr) int {
+	t.Helper()
+	fd, _, errno := unix.Syscall(
+		unix.SYS_BPF,
+		bpfMapCreate,
+		uintptr(unsafe.Pointer(&attribute)),
+		unsafe.Sizeof(attribute),
+	)
+	if errno != 0 {
+		t.Fatal(errno)
+	}
+	mapFD := int(fd)
+	t.Cleanup(func() { _ = unix.Close(mapFD) })
+	return mapFD
+}
