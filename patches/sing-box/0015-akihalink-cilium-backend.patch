diff --git a/protocol/ebpf/uid_policy_control.go b/protocol/ebpf/uid_policy_control.go
new file mode 100644
index 00000000..bd7d5735
--- /dev/null
+++ b/protocol/ebpf/uid_policy_control.go
@@ -0,0 +1,470 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	ECommon "github.com/sagernet/sing-box/common/ebpf"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	uidPolicySocketTimeout = 12 * time.Second
+	uidPolicyResetTimeout  = 10 * time.Second
+	androidUserUIDRange    = 100_000
+)
+
+func platformExcludedUIDRanges(goos string) []ECommon.UIDRange {
+	if goos != "android" {
+		return nil
+	}
+	// Android's network-stack service must keep its own control traffic out of
+	// the app-selected proxy path; verified netd resolver traffic is handled by
+	// the dedicated TGID override in the cgroup program.
+	return []ECommon.UIDRange{{Start: 1052, End: 1052}}
+}
+
+type uidPolicyControl struct {
+	listener   net.Listener
+	path       string
+	access     sync.Mutex
+	generation uint64
+	configured []ECommon.UIDRange
+	known      bool
+}
+
+type uidPolicyResetTarget struct {
+	UID         uint32 `json:"uid"`
+	UserID      uint32 `json:"userId"`
+	PackageName string `json:"packageName"`
+}
+
+type uidPolicyUpdateRequest struct {
+	Action          string                 `json:"action,omitempty"`
+	ExcludeUID      []uint32               `json:"exclude_uid,omitempty"`
+	ExcludeUIDRange []string               `json:"exclude_uid_range,omitempty"`
+	Packages        []uidPolicyResetTarget `json:"packages,omitempty"`
+	VerifyUIDs      []uint32               `json:"verifyUids,omitempty"`
+}
+
+type uidPolicyStatus struct {
+	Generation            uint64 `json:"generation"`
+	ConfiguredFingerprint string `json:"configuredFingerprint"`
+	LiveFingerprint       string `json:"liveFingerprint"`
+	EffectiveUIDs         int    `json:"effectiveUids"`
+	TCPBypassHits         uint64 `json:"tcpBypassHits"`
+	UDPBypassHits         uint64 `json:"udpBypassHits"`
+	InSync                bool   `json:"inSync"`
+	Known                 bool   `json:"known"`
+}
+
+type resolverControlStatus struct {
+	Required            bool   `json:"required"`
+	Discovered          int    `json:"discovered"`
+	PlainDNSCapture     uint64 `json:"plainDnsCapture"`
+	DNSOverTLSCapture   uint64 `json:"dnsOverTlsCapture"`
+	DNSOverHTTPSCapture uint64 `json:"dnsOverHttpsCapture"`
+}
+
+type uidPolicyConnectionReset struct {
+	RequestedPackages int      `json:"requestedPackages"`
+	StoppedPackages   int      `json:"stoppedPackages"`
+	VerifiedUIDs      int      `json:"verifiedUids"`
+	RemainingUIDs     []uint32 `json:"remainingUids"`
+}
+
+type uidPolicyUpdateResponse struct {
+	OK              bool                     `json:"ok"`
+	Error           string                   `json:"error,omitempty"`
+	PolicyStatus    uidPolicyStatus          `json:"policyStatus"`
+	ResolverStatus  resolverControlStatus    `json:"resolverStatus"`
+	ConnectionReset uidPolicyConnectionReset `json:"connectionReset"`
+}
+
+func (i *Inbound) startUIDPolicyControl() error {
+	if !i.cgroupEnabled || i.uidPolicyControl != nil {
+		return nil
+	}
+	socketPath := os.Getenv("AKIHALINK_UID_POLICY_SOCKET")
+	if socketPath == "" {
+		if os.Getenv("AKIHALINK_RUNTIME") != "" {
+			return errors.New("eBPF UID policy control socket path is required")
+		}
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(socketPath), 0o700); err != nil {
+		return fmt.Errorf("create eBPF UID policy socket directory: %w", err)
+	}
+	if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("remove stale eBPF UID policy socket: %w", err)
+	}
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return fmt.Errorf("listen for eBPF UID policy updates: %w", err)
+	}
+	if err = os.Chmod(socketPath, 0o600); err != nil {
+		_ = listener.Close()
+		_ = os.Remove(socketPath)
+		return fmt.Errorf("protect eBPF UID policy socket: %w", err)
+	}
+	control := &uidPolicyControl{
+		listener:   listener,
+		path:       socketPath,
+		generation: 1,
+		configured: append([]ECommon.UIDRange(nil), i.cgroupPolicy.ExcludeUID...),
+		known:      true,
+	}
+	status, statusErr := control.status(i)
+	if statusErr != nil || !status.InSync {
+		_ = listener.Close()
+		_ = os.Remove(socketPath)
+		if statusErr != nil {
+			return fmt.Errorf("inspect initial eBPF UID policy: %w", statusErr)
+		}
+		return errors.New("initial eBPF UID policy fingerprint mismatch")
+	}
+	i.uidPolicyControl = control
+	go i.serveUIDPolicyControl(control)
+	return nil
+}
+
+func (i *Inbound) stopUIDPolicyControl() {
+	control := i.uidPolicyControl
+	i.uidPolicyControl = nil
+	if control == nil {
+		return
+	}
+	_ = control.listener.Close()
+	_ = os.Remove(control.path)
+}
+
+func (i *Inbound) serveUIDPolicyControl(control *uidPolicyControl) {
+	for {
+		connection, err := control.listener.Accept()
+		if err != nil {
+			return
+		}
+		unixConnection, loaded := connection.(*net.UnixConn)
+		if !loaded {
+			_ = connection.Close()
+			continue
+		}
+		go i.handleUIDPolicyConnection(control, unixConnection)
+	}
+}
+
+func (i *Inbound) handleUIDPolicyConnection(control *uidPolicyControl, connection *net.UnixConn) {
+	defer connection.Close()
+	_ = connection.SetDeadline(time.Now().Add(uidPolicySocketTimeout))
+	response := uidPolicyUpdateResponse{}
+	if !uidPolicyPeerIsRoot(connection) {
+		response.Error = "UID policy operations require root"
+		_ = json.NewEncoder(connection).Encode(response)
+		return
+	}
+	var request uidPolicyUpdateRequest
+	if err := json.NewDecoder(io.LimitReader(connection, 1<<20)).Decode(&request); err != nil {
+		response.Error = "invalid UID policy request"
+		_ = json.NewEncoder(connection).Encode(response)
+		return
+	}
+	control.access.Lock()
+	defer control.access.Unlock()
+	var err error
+	switch request.Action {
+	case "", "apply":
+		response.PolicyStatus, response.ConnectionReset, err = i.applyExcludedUIDPolicy(control, request)
+	case "status":
+		response.PolicyStatus, err = control.status(i)
+	default:
+		err = errors.New("unknown UID policy action")
+	}
+	response.ResolverStatus, _ = i.resolverStatus()
+	if err != nil {
+		response.Error = err.Error()
+	} else {
+		response.OK = true
+	}
+	_ = json.NewEncoder(connection).Encode(response)
+}
+
+func uidPolicyPeerIsRoot(connection *net.UnixConn) bool {
+	rawConnection, err := connection.SyscallConn()
+	if err != nil {
+		return false
+	}
+	var credential *unix.Ucred
+	var controlErr error
+	err = rawConnection.Control(func(fd uintptr) {
+		credential, controlErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	})
+	return err == nil && controlErr == nil && credential != nil && credential.Uid == 0
+}
+
+func (i *Inbound) applyExcludedUIDPolicy(
+	control *uidPolicyControl,
+	request uidPolicyUpdateRequest,
+) (uidPolicyStatus, uidPolicyConnectionReset, error) {
+	ranges, err := parseUIDRanges(request.ExcludeUID, request.ExcludeUIDRange)
+	if err != nil {
+		return control.unknownStatus(), uidPolicyConnectionReset{}, err
+	}
+	ranges = append(ranges, platformExcludedUIDRanges(runtime.GOOS)...)
+	backend := i.cgroupBackendInstance()
+	if backend == nil {
+		return control.unknownStatus(), uidPolicyConnectionReset{}, errors.New("eBPF backend is not available")
+	}
+	previous := append([]ECommon.UIDRange(nil), control.configured...)
+	if err = backend.ReplaceExcludeUIDPolicy(ranges); err != nil {
+		control.known = false
+		return control.unknownStatus(), uidPolicyConnectionReset{}, err
+	}
+	control.generation++
+	forward, err := control.statusFor(i, ranges)
+	if err != nil || !forward.InSync {
+		rollback, rollbackErr := i.rollbackExcludedUIDPolicy(control, backend, previous)
+		if err == nil {
+			err = errors.New("live UID policy fingerprint did not match")
+		}
+		return rollback, uidPolicyConnectionReset{}, errors.Join(err, rollbackErr)
+	}
+	reset, err := resetUIDPolicyProcesses(request.Packages, request.VerifyUIDs)
+	if err != nil {
+		rollback, rollbackErr := i.rollbackExcludedUIDPolicy(control, backend, previous)
+		return rollback, reset, errors.Join(fmt.Errorf("reset affected application processes: %w", err), rollbackErr)
+	}
+	control.configured = append(control.configured[:0], ranges...)
+	control.known = true
+	i.cgroupPolicy.ExcludeUID = append([]ECommon.UIDRange(nil), ranges...)
+	return forward, reset, nil
+}
+
+func (i *Inbound) rollbackExcludedUIDPolicy(
+	control *uidPolicyControl,
+	backend *ECommon.CgroupBackend,
+	previous []ECommon.UIDRange,
+) (uidPolicyStatus, error) {
+	if err := backend.ReplaceExcludeUIDPolicy(previous); err != nil {
+		control.known = false
+		return control.unknownStatus(), err
+	}
+	control.generation++
+	status, err := control.statusFor(i, previous)
+	if err != nil || !status.InSync {
+		control.known = false
+		if err != nil {
+			return control.unknownStatus(), err
+		}
+		return control.unknownStatus(), errors.New("rollback UID policy fingerprint mismatch")
+	}
+	control.configured = append(control.configured[:0], previous...)
+	control.known = true
+	return status, nil
+}
+
+func (control *uidPolicyControl) status(i *Inbound) (uidPolicyStatus, error) {
+	return control.statusFor(i, control.configured)
+}
+
+func (control *uidPolicyControl) statusFor(i *Inbound, configured []ECommon.UIDRange) (uidPolicyStatus, error) {
+	configuredPolicy := i.cgroupPolicy
+	configuredPolicy.ExcludeUID = append([]ECommon.UIDRange(nil), configured...)
+	status := uidPolicyStatus{
+		Generation:            control.generation,
+		ConfiguredFingerprint: ECommon.UIDPolicyFingerprint(configuredPolicy),
+		Known:                 control.known,
+	}
+	backend := i.cgroupBackendInstance()
+	if backend == nil {
+		status.Known = false
+		return status, errors.New("eBPF backend is not available")
+	}
+	live, err := backend.UIDPolicySnapshot()
+	if err != nil {
+		status.Known = false
+		return status, err
+	}
+	status.LiveFingerprint = live.LiveFingerprint
+	status.EffectiveUIDs = live.EffectiveUIDs
+	status.TCPBypassHits = live.TCPBypassHits
+	status.UDPBypassHits = live.UDPBypassHits
+	status.InSync = status.Known && status.ConfiguredFingerprint == status.LiveFingerprint
+	return status, nil
+}
+
+func (control *uidPolicyControl) unknownStatus() uidPolicyStatus {
+	return uidPolicyStatus{Generation: control.generation, Known: false}
+}
+
+func (i *Inbound) resolverStatus() (resolverControlStatus, error) {
+	backend := i.cgroupBackendInstance()
+	if backend == nil {
+		return resolverControlStatus{}, errors.New("eBPF backend is not available")
+	}
+	status, err := backend.AndroidSystemResolverStatus()
+	return resolverControlStatus{
+		Required:            status.Required,
+		Discovered:          status.Discovered,
+		PlainDNSCapture:     status.PlainDNS,
+		DNSOverTLSCapture:   status.DNSOverTLS,
+		DNSOverHTTPSCapture: status.DNSOverHTTPS,
+	}, err
+}
+
+func resetUIDPolicyProcesses(targets []uidPolicyResetTarget, verifyUIDs []uint32) (uidPolicyConnectionReset, error) {
+	result := uidPolicyConnectionReset{RequestedPackages: len(targets)}
+	uniqueTargets := make(map[string]uidPolicyResetTarget, len(targets))
+	for _, target := range targets {
+		if !validUIDPolicyResetTarget(target) {
+			return result, errors.New("invalid affected application package")
+		}
+		uniqueTargets[strconv.FormatUint(uint64(target.UserID), 10)+":"+target.PackageName] = target
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), uidPolicyResetTimeout)
+	defer cancel()
+	orderedTargets := make([]uidPolicyResetTarget, 0, len(uniqueTargets))
+	for _, target := range uniqueTargets {
+		orderedTargets = append(orderedTargets, target)
+	}
+	sort.Slice(orderedTargets, func(left, right int) bool {
+		if orderedTargets[left].UserID != orderedTargets[right].UserID {
+			return orderedTargets[left].UserID < orderedTargets[right].UserID
+		}
+		return orderedTargets[left].PackageName < orderedTargets[right].PackageName
+	})
+	for _, target := range orderedTargets {
+		command := exec.CommandContext(ctx, "cmd", "activity", "force-stop", "--user",
+			strconv.FormatUint(uint64(target.UserID), 10), target.PackageName)
+		if output, err := command.CombinedOutput(); err != nil {
+			return result, fmt.Errorf("force-stop %s: %w: %s", target.PackageName, err, strings.TrimSpace(string(output)))
+		}
+		result.StoppedPackages++
+	}
+	verify := uniqueUIDs(verifyUIDs)
+	for {
+		remaining, err := activeUIDs(verify)
+		if err != nil {
+			return result, err
+		}
+		result.RemainingUIDs = remaining
+		result.VerifiedUIDs = len(verify) - len(remaining)
+		if len(remaining) == 0 {
+			return result, nil
+		}
+		select {
+		case <-ctx.Done():
+			return result, errors.New("affected application processes remained active")
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+}
+
+func validUIDPolicyResetTarget(target uidPolicyResetTarget) bool {
+	if target.UID < 10_000 || target.UID%androidUserUIDRange > 19_999 ||
+		target.UserID != target.UID/androidUserUIDRange {
+		return false
+	}
+	parts := strings.Split(target.PackageName, ".")
+	if len(parts) < 2 {
+		return false
+	}
+	for _, part := range parts {
+		if part == "" || !isPackageIdentifierStart(part[0]) {
+			return false
+		}
+		for _, character := range part[1:] {
+			if !isPackageIdentifierPart(character) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func isPackageIdentifierStart(value byte) bool {
+	return value >= 'A' && value <= 'Z' || value >= 'a' && value <= 'z'
+}
+
+func isPackageIdentifierPart(value rune) bool {
+	return isPackageIdentifierStart(byte(value)) || value >= '0' && value <= '9' || value == '_'
+}
+
+func uniqueUIDs(values []uint32) []uint32 {
+	unique := make(map[uint32]struct{}, len(values))
+	for _, value := range values {
+		if value >= 10_000 {
+			unique[value] = struct{}{}
+		}
+	}
+	result := make([]uint32, 0, len(unique))
+	for value := range unique {
+		result = append(result, value)
+	}
+	sort.Slice(result, func(left, right int) bool { return result[left] < result[right] })
+	return result
+}
+
+func activeUIDs(uids []uint32) ([]uint32, error) {
+	if len(uids) == 0 {
+		return nil, nil
+	}
+	requested := make(map[uint32]struct{}, len(uids))
+	for _, uid := range uids {
+		requested[uid] = struct{}{}
+	}
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil, err
+	}
+	active := make(map[uint32]struct{})
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			continue
+		}
+		if _, err = strconv.ParseUint(entry.Name(), 10, 32); err != nil {
+			continue
+		}
+		status, readErr := os.ReadFile(filepath.Join("/proc", entry.Name(), "status"))
+		if readErr != nil {
+			continue
+		}
+		for _, line := range strings.Split(string(status), "\n") {
+			if !strings.HasPrefix(line, "Uid:") {
+				continue
+			}
+			fields := strings.Fields(line)
+			if len(fields) < 2 {
+				break
+			}
+			uid, parseErr := strconv.ParseUint(fields[1], 10, 32)
+			if parseErr == nil {
+				if _, found := requested[uint32(uid)]; found {
+					active[uint32(uid)] = struct{}{}
+				}
+			}
+			break
+		}
+	}
+	remaining := make([]uint32, 0, len(active))
+	for uid := range active {
+		remaining = append(remaining, uid)
+	}
+	sort.Slice(remaining, func(left, right int) bool { return remaining[left] < remaining[right] })
+	return remaining, nil
+}
