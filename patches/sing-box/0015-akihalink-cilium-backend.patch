+// WriteMsgUDPAddrPortBatch writes datagrams with per-packet control messages.
+// Unsupported or policy-blocked mmsg syscalls permanently select the standard
+// WriteMsgUDPAddrPort path for this listener.
+func (l *Listener) WriteMsgUDPAddrPortBatch(
+	payloads [][]byte,
+	oobs [][]byte,
+	destinations []netip.AddrPort,
+) error {
+	if len(payloads) == 0 || len(payloads) != len(oobs) || len(payloads) != len(destinations) {
+		return os.ErrInvalid
+	}
+	sent := 0
+	if !l.udpOOBBatchDisabled.Load() {
+		batchSent, unsupported, err := writeMsgUDPAddrPortBatch(l.udpConn, payloads, oobs, destinations)
+		sent = batchSent
+		if unsupported {
+			l.udpOOBBatchDisabled.Store(true)
+		} else if err != nil {
+			return err
+		} else if sent == len(payloads) {
+			return nil
+		}
+	}
+	for index := sent; index < len(payloads); index++ {
+		if _, _, err := l.udpConn.WriteMsgUDPAddrPort(payloads[index], oobs[index], destinations[index]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
