diff --git a/protocol/ebpf/android_tethering.go b/protocol/ebpf/android_tethering.go
new file mode 100644
index 0000000000000000000000000000000000000000..8d37ecd0d6c9026484325275b5047b4903aab56b
--- /dev/null
+++ b/protocol/ebpf/android_tethering.go
@@ -0,0 +1,40 @@
+//go:build with_ebpf && android
+
+package ebpf
+
+import (
+	"context"
+	"net"
+	"os/exec"
+	"sort"
+	"time"
+)
+
+const androidTetheringDiscoveryTimeout = 2 * time.Second
+
+func discoverAndroidWifiTetheringInterfaces() ([]string, error) {
+	available, err := net.Interfaces()
+	if err != nil {
+		return nil, err
+	}
+	byName := make(map[string]net.Interface, len(available))
+	for _, networkInterface := range available {
+		byName[networkInterface.Name] = networkInterface
+	}
+	candidates := make(map[string]struct{})
+	for _, service := range []string{"tethering"} {
+		ctx, cancel := context.WithTimeout(context.Background(), androidTetheringDiscoveryTimeout)
+		content, commandErr := exec.CommandContext(ctx, "dumpsys", service).Output()
+		cancel()
+		if commandErr != nil {
+			return nil, commandErr
+		}
+		collectAndroidTetheringCandidates(candidates, byName, string(content))
+	}
+	interfaces := make([]string, 0, len(candidates))
+	for name := range candidates {
+		interfaces = append(interfaces, name)
+	}
+	sort.Strings(interfaces)
+	return interfaces, nil
+}
diff --git a/protocol/ebpf/android_tethering_interfaces.go b/protocol/ebpf/android_tethering_interfaces.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b9231e21113f0ff8f5ac54e3f4eaba9709a5e66
--- /dev/null
+++ b/protocol/ebpf/android_tethering_interfaces.go
@@ -0,0 +1,48 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func (i *Inbound) activeSharedInterfaces(defaultInterface string) []string {
+	interfaces := i.sharedOptions.Interface
+	if i.sharedEnabled && i.sharedOptions.AndroidTethering == "wifi" {
+		var err error
+		interfaces, err = discoverAndroidWifiTetheringInterfaces()
+		i.hotspotDiscoveryFailed.Store(err != nil)
+		if err != nil {
+			i.interfaceWarnings.topology.warn(i.logger, "discover Android Wi-Fi tethering: ", err)
+			i.publishHotspotState("failed")
+			return nil
+		}
+	}
+	return activeSharedInterfaces(interfaces, defaultInterface)
+}
+
+func (i *Inbound) publishHotspotState(state string) {
+	if i.sharedOptions.AndroidTethering != "wifi" {
+		return
+	}
+	if i.hotspotDiscoveryFailed.Load() {
+		state = "failed"
+	}
+	runtimeDir := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDir == "" {
+		return
+	}
+	temporary, err := os.CreateTemp(runtimeDir, ".hotspot-state-*")
+	if err != nil {
+		return
+	}
+	defer os.Remove(temporary.Name())
+	_, err = temporary.WriteString(state + "\n")
+	if closeErr := temporary.Close(); err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		_ = os.Rename(temporary.Name(), filepath.Join(runtimeDir, "hotspot.state"))
+	}
+}
diff --git a/protocol/ebpf/android_tethering_parse.go b/protocol/ebpf/android_tethering_parse.go
new file mode 100644
index 0000000000000000000000000000000000000000..4b33a3878d391964c45ad27363163835bb815bc8
--- /dev/null
+++ b/protocol/ebpf/android_tethering_parse.go
@@ -0,0 +1,34 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"net"
+	"regexp"
+	"strings"
+)
+
+var (
+	androidTetheringToken = regexp.MustCompile(`[A-Za-z0-9_.:-]{2,32}`)
+	androidWifiAPName     = regexp.MustCompile(`(?i)^(ap|softap|swlan|wlan[1-9]|wifi[-_]?ap|br[-_]?wifi|br[-_]?wlan)[A-Za-z0-9_.:-]*$`)
+)
+
+func collectAndroidTetheringCandidates(
+	candidates map[string]struct{},
+	available map[string]net.Interface,
+	output string,
+) {
+	for _, line := range strings.Split(output, "\n") {
+		lower := strings.ToLower(line)
+		if !strings.Contains(lower, "tetheredstate") || strings.Contains(lower, "untetheredstate") {
+			continue
+		}
+		for _, token := range androidTetheringToken.FindAllString(line, -1) {
+			networkInterface, loaded := available[token]
+			if !loaded || len(networkInterface.HardwareAddr) != 6 || !androidWifiAPName.MatchString(token) {
+				continue
+			}
+			candidates[token] = struct{}{}
+		}
+	}
+}
diff --git a/protocol/ebpf/android_tethering_parse_test.go b/protocol/ebpf/android_tethering_parse_test.go
