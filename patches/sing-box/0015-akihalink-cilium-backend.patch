diff --git a/common/ebpf/readiness_akihalink.go b/common/ebpf/readiness_akihalink.go
new file mode 100644
index 00000000..04013fb0
--- /dev/null
+++ b/common/ebpf/readiness_akihalink.go
@@ -0,0 +1,102 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// MarkReady publishes the marker only after the protocol layer has attached
+// the cgroup programs and bound the root-only UID policy control socket.
+func (b *CgroupBackend) MarkReady() error {
+	if b == nil {
+		return errBackendClosed
+	}
+	b.access.RLock()
+	defer b.access.RUnlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return err
+	}
+	attached := false
+	for _, value := range b.runtime.attached {
+		attached = attached || value
+	}
+	if !attached {
+		return fmt.Errorf("eBPF cgroup programs are not attached")
+	}
+	runtimeDir := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDir == "" {
+		return nil
+	}
+	resolver := AndroidSystemResolverStatus{
+		Required:   b.runtime.system_resolver,
+		Discovered: len(b.systemResolverTGIDs),
+	}
+	if resolver.Required && resolver.Discovered == 0 {
+		return fmt.Errorf("Android system resolver is not ready")
+	}
+	startTime, err := currentProcessStartTimeForReadiness()
+	if err != nil {
+		return err
+	}
+	content := fmt.Sprintf(
+		"pid=%d\nstarttime=%s\nstartup_health=healthy\nsystem_resolver_attached=%d\nresolver_discovered=%d\n",
+		os.Getpid(), startTime, boolToInt(!resolver.Required || resolver.Discovered > 0), resolver.Discovered,
+	)
+	return atomicReadinessWrite(filepath.Join(runtimeDir, "core.ready"), []byte(content))
+}
+
+func (b *CgroupBackend) removeReadinessMarker() {
+	runtimeDir := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDir != "" {
+		_ = os.Remove(filepath.Join(runtimeDir, "core.ready"))
+	}
+}
+
+func currentProcessStartTimeForReadiness() (string, error) {
+	stat, err := os.ReadFile("/proc/self/stat")
+	if err != nil {
+		return "", err
+	}
+	closeParen := strings.LastIndexByte(string(stat), ')')
+	if closeParen < 0 {
+		return "", fmt.Errorf("invalid process stat")
+	}
+	fields := strings.Fields(string(stat)[closeParen+1:])
+	if len(fields) <= 19 {
+		return "", fmt.Errorf("incomplete process stat")
+	}
+	return fields[19], nil
+}
+
+func atomicReadinessWrite(path string, content []byte) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".core-ready-*")
+	if err != nil {
+		return err
+	}
+	temporaryPath := temporary.Name()
+	defer os.Remove(temporaryPath)
+	if err = temporary.Chmod(0o600); err == nil {
+		_, err = temporary.Write(content)
+	}
+	if closeErr := temporary.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(temporaryPath, path)
+}
+
+func boolToInt(value bool) int {
+	if value {
+		return 1
+	}
+	return 0
+}
diff --git a/common/ebpf/readiness_akihalink_test.go b/common/ebpf/readiness_akihalink_test.go
new file mode 100644
index 00000000..398dc2e9
--- /dev/null
+++ b/common/ebpf/readiness_akihalink_test.go
@@ -0,0 +1,43 @@
+//go:build with_ebpf && linux
+
+package ebpf
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAtomicReadinessWrite(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "runtime", "core.ready")
+	if err := atomicReadinessWrite(path, []byte("first\n")); err != nil {
+		t.Fatal(err)
+	}
+	if err := atomicReadinessWrite(path, []byte("second\n")); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(content) != "second\n" {
+		t.Fatalf("unexpected readiness content: %q", content)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("unexpected readiness mode: %o", info.Mode().Perm())
+	}
+}
+
+func TestCurrentProcessStartTimeForReadiness(t *testing.T) {
+	startTime, err := currentProcessStartTimeForReadiness()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if startTime == "" {
+		t.Fatal("empty process start time")
+	}
+}
diff --git a/common/ebpf/uid_policy_live.go b/common/ebpf/uid_policy_live.go
new file mode 100644
index 00000000..8fb9c1ab
--- /dev/null
+++ b/common/ebpf/uid_policy_live.go
@@ -0,0 +1,282 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"slices"
+	"sort"
+	"unsafe"
+
+	E "github.com/sagernet/sing/common/exceptions"
+
+	CiliumEBPF "github.com/cilium/ebpf"
+	"golang.org/x/sys/unix"
+)
+
+type UIDPolicySnapshot struct {
+	LiveFingerprint string
+	EffectiveUIDs   int
+	TCPBypassHits   uint64
+	UDPBypassHits   uint64
+}
+
+func cloneUIDPolicyEntries(entries []uidLPMKey) []uidLPMKey {
+	return slices.Clone(entries)
+}
+
+func cloneCgroupPolicy(policy CgroupPolicy) CgroupPolicy {
+	policy.IncludeUID = slices.Clone(policy.IncludeUID)
+	policy.ExcludeUID = slices.Clone(policy.ExcludeUID)
+	return policy
+}
+
+// ReplaceExcludeUIDPolicy updates the attached LPM trie add-first and
+// delete-second. A failed rollback invalidates the backend so callers rebuild
+// it instead of continuing with an unknown policy.
+func (b *CgroupBackend) ReplaceExcludeUIDPolicy(uidRanges []UIDRange) error {
+	if b == nil {
+		return errBackendClosed
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return err
+	}
+	nextPolicy := cloneCgroupPolicy(b.uidPolicy)
+	nextPolicy.ExcludeUID = slices.Clone(uidRanges)
+	nextEntries, defaultBypass, err := compileUIDPolicy(nextPolicy)
+	if err != nil {
+		return err
+	}
+	if defaultBypass != b.uidDefaultBypass {
+		return E.New("live UID policy update changed default bypass semantics")
+	}
+	if slices.Equal(nextEntries, b.uidPolicyEntries) {
+		b.uidPolicy = nextPolicy
+		return nil
+	}
+	uidMap := b.runtime.maps["cgroup_uid_policy"]
+	if err = replaceUIDPolicyMap(uidMap, b.uidPolicyEntries, nextEntries); err != nil {
+		if policyRollbackFailed(err) {
+			return E.Errors(err, b.health.invalidate("cgroup", "UID policy"))
+		}
+		return err
+	}
+	b.uidPolicyEntries = slices.Clone(nextEntries)
+	b.uidPolicy = nextPolicy
+	return nil
+}
+
+func replaceUIDPolicyMap(mapInstance *CiliumEBPF.Map, currentEntries, nextEntries []uidLPMKey) error {
+	if mapInstance == nil {
+		return errBackendClosed
+	}
+	current := make(map[uidLPMKey]struct{}, len(currentEntries))
+	for _, entry := range currentEntries {
+		current[entry] = struct{}{}
+	}
+	next := make(map[uidLPMKey]struct{}, len(nextEntries))
+	for _, entry := range nextEntries {
+		next[entry] = struct{}{}
+	}
+	additions := make([]uidLPMKey, 0, len(next))
+	for entry := range next {
+		if _, loaded := current[entry]; !loaded {
+			additions = append(additions, entry)
+		}
+	}
+	removals := make([]uidLPMKey, 0, len(current))
+	for entry := range current {
+		if _, loaded := next[entry]; !loaded {
+			removals = append(removals, entry)
+		}
+	}
+	sortUIDPolicyEntries(additions)
+	sortUIDPolicyEntries(removals)
+	added, err := addUIDPolicyEntries(mapInstance, additions)
+	if err != nil {
+		return policyUpdateError(err, rollbackUIDPolicyMap(mapInstance, added, nil))
+	}
+	removed, err := removeUIDPolicyEntries(mapInstance, removals)
+	if err != nil {
+		return policyUpdateError(err, rollbackUIDPolicyMap(mapInstance, added, removed))
+	}
+	return nil
+}
+
+func addUIDPolicyEntries(mapInstance *CiliumEBPF.Map, entries []uidLPMKey) ([]uidLPMKey, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	values := make([]uint8, len(entries))
+	for index := range values {
+		values[index] = 1
+	}
+	processed, err := updateMapBatch(mapInstance, entries, values, bpfNoExist, &uidPolicyUpdateBatchSupport)
+	if processed > uint32(len(entries)) {
+		return nil, E.New("invalid eBPF UID batch update count: ", processed)
+	}
+	added := slices.Clone(entries[:processed])
+	if err == nil {
+		return added, nil
+	}
+	if !errors.Is(err, unix.EEXIST) && !errors.Is(err, CiliumEBPF.ErrKeyExist) {
+		return added, err
+	}
+	value := uint8(1)
+	for _, entry := range entries[processed:] {
+		err = updateMapWithFlags(mapInstance.FD(), unsafe.Pointer(&entry), unsafe.Pointer(&value), bpfNoExist)
+		if errors.Is(err, unix.EEXIST) || errors.Is(err, CiliumEBPF.ErrKeyExist) {
+			continue
+		}
+		if err != nil {
+			return added, err
+		}
+		added = append(added, entry)
+	}
+	return added, nil
+}
+
+func removeUIDPolicyEntries(mapInstance *CiliumEBPF.Map, entries []uidLPMKey) ([]uidLPMKey, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	processed, err := deleteMapBatch(mapInstance, entries, &uidPolicyDeleteBatchSupport)
+	if processed > uint32(len(entries)) {
+		return nil, E.New("invalid eBPF UID batch delete count: ", processed)
+	}
+	removed := slices.Clone(entries[:processed])
+	if err == nil {
+		return removed, nil
+	}
+	if !errors.Is(err, unix.ENOENT) && !errors.Is(err, CiliumEBPF.ErrKeyNotExist) {
+		return removed, err
+	}
+	for _, entry := range entries[processed:] {
+		err = deleteMap(mapInstance.FD(), unsafe.Pointer(&entry))
+		if errors.Is(err, unix.ENOENT) || errors.Is(err, CiliumEBPF.ErrKeyNotExist) {
+			continue
+		}
+		if err != nil {
+			return removed, err
+		}
+		removed = append(removed, entry)
+	}
+	return removed, nil
+}
+
+func rollbackUIDPolicyMap(mapInstance *CiliumEBPF.Map, added, removed []uidLPMKey) error {
+	if mapInstance == nil {
+		return errBackendClosed
+	}
+	var rollbackErr error
+	value := uint8(1)
+	for _, entry := range removed {
+		if err := updateMap(mapInstance.FD(), unsafe.Pointer(&entry), unsafe.Pointer(&value)); err != nil {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	for _, entry := range added {
+		if err := deleteMap(mapInstance.FD(), unsafe.Pointer(&entry)); err != nil &&
+			!errors.Is(err, unix.ENOENT) && !errors.Is(err, CiliumEBPF.ErrKeyNotExist) {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	return rollbackErr
+}
+
+func (b *CgroupBackend) UIDPolicySnapshot() (UIDPolicySnapshot, error) {
+	if b == nil {
+		return UIDPolicySnapshot{}, errBackendClosed
+	}
+	b.access.RLock()
+	defer b.access.RUnlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return UIDPolicySnapshot{}, err
+	}
+	entries, err := readUIDPolicyMap(b.runtime.maps["cgroup_uid_policy"])
+	if err != nil {
+		return UIDPolicySnapshot{}, err
+	}
+	tcp, err := b.readCgroupStatLocked(cgroupStatTCPUIDBypass)
+	if err != nil {
+		return UIDPolicySnapshot{}, err
+	}
+	udp, err := b.readCgroupStatLocked(cgroupStatUDPUIDBypass)
+	if err != nil {
+		return UIDPolicySnapshot{}, err
+	}
+	return UIDPolicySnapshot{
+		LiveFingerprint: uidPolicyEntriesFingerprint(entries, b.uidDefaultBypass),
+		EffectiveUIDs:   len(entries),
+		TCPBypassHits:   tcp,
+		UDPBypassHits:   udp,
+	}, nil
+}
+
+func UIDPolicyFingerprint(policy CgroupPolicy) string {
+	entries, defaultBypass, err := compileUIDPolicy(policy)
+	if err != nil {
+		return ""
+	}
+	return uidPolicyEntriesFingerprint(entries, defaultBypass)
+}
+
+func readUIDPolicyMap(mapInstance *CiliumEBPF.Map) ([]uidLPMKey, error) {
+	if mapInstance == nil {
+		return nil, errBackendClosed
+	}
+	entries := make([]uidLPMKey, 0)
+	iterator := mapInstance.Iterate()
+	var key uidLPMKey
+	var value uint8
+	for iterator.Next(&key, &value) {
+		if value != 0 {
+			entries = append(entries, key)
+		}
+	}
+	if err := iterator.Err(); err != nil {
+		return nil, err
+	}
+	sortUIDPolicyEntries(entries)
+	return entries, nil
+}
+
+func sortUIDPolicyEntries(entries []uidLPMKey) {
+	sort.Slice(entries, func(left, right int) bool {
+		if entries[left].PrefixLength != entries[right].PrefixLength {
+			return entries[left].PrefixLength < entries[right].PrefixLength
+		}
+		return binary.BigEndian.Uint32(entries[left].UID[:]) < binary.BigEndian.Uint32(entries[right].UID[:])
+	})
+}
+
+func uidPolicyEntriesFingerprint(entries []uidLPMKey, defaultBypass bool) string {
+	entries = slices.Clone(entries)
+	sortUIDPolicyEntries(entries)
+	hash := sha256.New()
+	if defaultBypass {
+		hash.Write([]byte{1})
+	} else {
+		hash.Write([]byte{0})
+	}
+	var encoded [8]byte
+	for _, entry := range entries {
+		binary.BigEndian.PutUint32(encoded[:4], entry.PrefixLength)
+		copy(encoded[4:], entry.UID[:])
+		hash.Write(encoded[:])
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func (b *CgroupBackend) readCgroupStatLocked(index uint32) (uint64, error) {
+	var value uint64
+	if err := lookupMap(b.statsMapFD, unsafe.Pointer(&index), unsafe.Pointer(&value)); err != nil {
+		return 0, err
+	}
+	return value, nil
+}
diff --git a/common/ebpf/uid_policy_live_integration_test.go b/common/ebpf/uid_policy_live_integration_test.go
new file mode 100644
index 00000000..0013c5f2
--- /dev/null
+++ b/common/ebpf/uid_policy_live_integration_test.go
@@ -0,0 +1,68 @@
+//go:build with_ebpf && (linux || android) && ebpf_integration
+
+package ebpf
+
+import (
+	"slices"
+	"testing"
+	"unsafe"
+
+	CiliumEBPF "github.com/cilium/ebpf"
+)
+
+func TestUIDPolicyMapTransactionIntegration(t *testing.T) {
+	requireEBPFIntegration(t, "test transactional UID policy replacement")
+	current := compileUIDRanges([]UIDRange{{Start: 1000, End: 1000}, {Start: 1002, End: 1002}})
+	next := compileUIDRanges([]UIDRange{{Start: 2000, End: 2000}, {Start: 2002, End: 2002}})
+	mapInstance := newUIDPolicyIntegrationMap(t, 4)
+	if err := populateUIDPolicyMap(mapInstance, current); err != nil {
+		t.Fatal(err)
+	}
+	if err := replaceUIDPolicyMap(mapInstance, current, next); err != nil {
+		t.Fatal(err)
+	}
+	assertUIDPolicyIntegrationEntries(t, mapInstance, next)
+}
+
+func TestUIDPolicyMapCapacityFailureRollsBackIntegration(t *testing.T) {
+	requireEBPFIntegration(t, "test UID policy rollback after capacity failure")
+	current := compileUIDRanges([]UIDRange{{Start: 1000, End: 1000}, {Start: 1002, End: 1002}})
+	next := compileUIDRanges([]UIDRange{{Start: 2000, End: 2000}, {Start: 2002, End: 2002}})
+	mapInstance := newUIDPolicyIntegrationMap(t, 3)
+	if err := populateUIDPolicyMap(mapInstance, current); err != nil {
+		t.Fatal(err)
+	}
+	if err := replaceUIDPolicyMap(mapInstance, current, next); err == nil {
+		t.Fatal("expected add-before-delete replacement to fail at map capacity")
+	}
+	assertUIDPolicyIntegrationEntries(t, mapInstance, current)
+}
+
+func newUIDPolicyIntegrationMap(t *testing.T, capacity uint32) *CiliumEBPF.Map {
+	t.Helper()
+	mapInstance, err := CiliumEBPF.NewMap(&CiliumEBPF.MapSpec{
+		Type:       CiliumEBPF.LPMTrie,
+		KeySize:    uint32(unsafe.Sizeof(uidLPMKey{})),
+		ValueSize:  uint32(unsafe.Sizeof(uint8(0))),
+		MaxEntries: capacity,
+		Flags:      bpfFlagNoPrealloc,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = mapInstance.Close() })
+	return mapInstance
+}
+
+func assertUIDPolicyIntegrationEntries(t *testing.T, mapInstance *CiliumEBPF.Map, expected []uidLPMKey) {
+	t.Helper()
+	actual, err := readUIDPolicyMap(mapInstance)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected = slices.Clone(expected)
+	sortUIDPolicyEntries(expected)
+	if !slices.Equal(actual, expected) {
+		t.Fatalf("unexpected UID policy map contents: got=%v expected=%v", actual, expected)
+	}
+}
