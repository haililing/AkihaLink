new file mode 100644
index 0000000000000000000000000000000000000000..2232569ffc0f461c67374273fc24640305d00f8a
--- /dev/null
+++ b/protocol/ebpf/shared_rewrite_journal.go
@@ -0,0 +1,81 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+func (a *sharedRewriteAttachment) saveAkihaLinkJournal() error {
+	runtimeDir := os.Getenv("AKIHALINK_RUNTIME")
+	if runtimeDir == "" {
+		return nil
+	}
+	directory := filepath.Join(runtimeDir, "shared-network")
+	if err := os.MkdirAll(directory, 0o700); err != nil {
+		return err
+	}
+	value, err := os.ReadFile(sharedRewriteLocalnetPath(a.interfaceName))
+	if err != nil {
+		return err
+	}
+	original, err := strconv.Atoi(strings.TrimSpace(string(value)))
+	if err != nil || (original != 0 && original != 1) {
+		return os.ErrInvalid
+	}
+	// An earlier attachment may already own the 0 -> 1 transition. Carry its
+	// restoration duty through an atomic replacement, including crash recovery.
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		content, readErr := os.ReadFile(filepath.Join(directory, entry.Name()))
+		if readErr != nil {
+			return readErr
+		}
+		var prior struct {
+			InterfaceIndex int    `json:"interfaceIndex"`
+			InterfaceName  string `json:"interfaceName"`
+			Original       int    `json:"routeLocalnetOriginal"`
+		}
+		if json.Unmarshal(content, &prior) == nil && prior.InterfaceIndex == a.interfaceIndex && prior.InterfaceName == a.interfaceName && prior.Original == 0 {
+			original = 0
+		}
+	}
+	content, err := json.Marshal(map[string]any{
+		"interfaceName": a.interfaceName, "interfaceIndex": a.interfaceIndex,
+		"routeLocalnetOriginal": original, "createdClsact": false,
+		"ingressName": a.ingressName, "egressName": a.egressName,
+		"ingressHandle": a.ingressHandle, "egressHandle": a.egressHandle,
+	})
+	if err != nil {
+		return err
+	}
+	a.journalPath = filepath.Join(directory, strconv.Itoa(a.interfaceIndex)+"-"+a.ingressName+".json")
+	temporary, err := os.CreateTemp(directory, ".journal-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temporary.Name())
+	if err = temporary.Chmod(0o600); err == nil {
+		_, err = temporary.Write(content)
+	}
+	if syncErr := temporary.Sync(); err == nil {
+		err = syncErr
+	}
+	if closeErr := temporary.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(temporary.Name(), a.journalPath)
+}
