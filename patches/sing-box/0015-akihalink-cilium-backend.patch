new file mode 100644
index 0000000000000000000000000000000000000000..ada81a3329295c95a9d69845096f9624e94bc10b
--- /dev/null
+++ b/common/ebpf/android_system_resolver_test.go
@@ -0,0 +1,79 @@
+//go:build with_ebpf && linux
+
+package ebpf
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAndroidSystemResolverIdentity(t *testing.T) {
+	procRoot := t.TempDir()
+	processRoot := filepath.Join(procRoot, "123")
+	if err := os.MkdirAll(processRoot, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	write := func(name string, content []byte) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(processRoot, name), content, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("status", []byte("Name:\tnetd\nUid:\t0\t0\t0\t0\n"))
+	write("cmdline", []byte("/system/bin/netd\x00"))
+	if err := os.Symlink("/system/bin/netd", filepath.Join(processRoot, "exe")); err != nil {
+		t.Fatal(err)
+	}
+	for _, testCase := range []struct {
+		threadName string
+		accepted   bool
+	}{
+		{"netd", true},
+		{"Binder:netd", true},
+		{"binder:123_4", true},
+		{"Binder:123_4", true},
+		{"binder:456_4", false},
+		{"binder:123_worker", false},
+	} {
+		write("comm", []byte(testCase.threadName+"\n"))
+		if actual := isAndroidSystemResolverProcess(procRoot, "123"); actual != testCase.accepted {
+			t.Fatalf("thread name %q accepted=%t, want %t", testCase.threadName, actual, testCase.accepted)
+		}
+	}
+	write("comm", []byte("netd\n"))
+	write("status", []byte("Name:\tnetd\nUid:\t1000\t1000\t1000\t1000\n"))
+	if isAndroidSystemResolverProcess(procRoot, "123") {
+		t.Fatal("non-root netd identity was accepted")
+	}
+}
+
+func TestAndroidSystemResolverExecutableFallback(t *testing.T) {
+	for _, testCase := range []struct {
+		name          string
+		command       string
+		executable    string
+		executableErr error
+		accepted      bool
+	}{
+		{"readable system executable", "/system/bin/netd", "/system/bin/netd", nil, true},
+		{"readable bare command", "netd", "/system/bin/netd", nil, true},
+		{"readable wrong executable", "/system/bin/netd", "/data/local/tmp/netd-wrapper", nil, false},
+		{"permission denied system command", "/system/bin/netd", "", os.ErrPermission, true},
+		{"permission denied APEX command", "/apex/com.android.tethering/bin/netd", "", os.ErrPermission, true},
+		{"permission denied data command", "/data/local/tmp/netd", "", os.ErrPermission, false},
+		{"missing system executable", "/system/bin/netd", "", os.ErrNotExist, false},
+		{"wrong command", "/system/bin/not-netd", "/system/bin/netd", nil, false},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			actual := isAndroidSystemResolverExecutable(
+				testCase.command,
+				testCase.executable,
+				testCase.executableErr,
+			)
+			if actual != testCase.accepted {
+				t.Fatalf("accepted=%t, want %t", actual, testCase.accepted)
+			}
+		})
+	}
+}
