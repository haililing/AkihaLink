+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"net"
+	"testing"
+)
+
+func TestCollectAndroidTetheringCandidatesOnlySelectsWiFi(t *testing.T) {
+	mac := net.HardwareAddr{0x02, 0x00, 0x00, 0x00, 0x00, 0x01}
+	available := map[string]net.Interface{
+		"ap0":      {Name: "ap0", HardwareAddr: mac},
+		"swlan0":   {Name: "swlan0", HardwareAddr: mac},
+		"br-wifi0": {Name: "br-wifi0", HardwareAddr: mac},
+		"wlan0":    {Name: "wlan0", HardwareAddr: mac},
+		"rndis0":   {Name: "rndis0", HardwareAddr: mac},
+		"bt-pan":   {Name: "bt-pan", HardwareAddr: mac},
+	}
+	candidates := make(map[string]struct{})
+	collectAndroidTetheringCandidates(candidates, available, `
+SoftApManager: interface=ap0
+WiFi tether downstream: swlan0 br-wifi0
+USB tether downstream: rndis0
+Bluetooth tether interface: bt-pan
+upstream interface: wlan0
+`)
+	for _, expected := range []string{"ap0", "swlan0", "br-wifi0"} {
+		if _, loaded := candidates[expected]; !loaded {
+			t.Fatalf("missing Wi-Fi tethering candidate %s: %v", expected, candidates)
+		}
+	}
+	for _, rejected := range []string{"wlan0", "rndis0", "bt-pan"} {
+		if _, loaded := candidates[rejected]; loaded {
+			t.Fatalf("non-Wi-Fi interface %s was selected: %v", rejected, candidates)
+		}
+	}
+}
