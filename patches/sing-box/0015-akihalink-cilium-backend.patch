diff --git a/common/ebpf/android_system_resolver.go b/common/ebpf/android_system_resolver.go
new file mode 100644
index 0000000000000000000000000000000000000000..f7238b21ea80d6c865298f06a5e1694aca774c42
--- /dev/null
+++ b/common/ebpf/android_system_resolver.go
@@ -0,0 +1,291 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+	"unsafe"
+
+	E "github.com/sagernet/sing/common/exceptions"
+
+	CiliumEBPF "github.com/cilium/ebpf"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	androidSystemResolverRefreshInterval = 2 * time.Second
+	maxAndroidSystemResolverTGIDs        = 16
+)
+
+type AndroidSystemResolverStatus struct {
+	Required     bool
+	Discovered   int
+	PlainDNS     uint64
+	DNSOverTLS   uint64
+	DNSOverHTTPS uint64
+}
+
+func androidSystemResolverRequired() bool {
+	return runtime.GOOS == "android" && os.Getenv("AKIHALINK_RUNTIME") != ""
+}
+
+func discoverAndroidSystemResolverTGIDs(enabled bool) (map[uint32]struct{}, error) {
+	result := make(map[uint32]struct{})
+	if !enabled {
+		return result, nil
+	}
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil, err
+	}
+	for _, entry := range entries {
+		pid, parseErr := strconv.ParseUint(entry.Name(), 10, 32)
+		if parseErr != nil || !isAndroidSystemResolverProcess("/proc", entry.Name()) {
+			continue
+		}
+		result[uint32(pid)] = struct{}{}
+		if len(result) > maxAndroidSystemResolverTGIDs {
+			return nil, fmt.Errorf("too many verified Android netd processes")
+		}
+	}
+	return result, nil
+}
+
+func isAndroidSystemResolverProcess(procRoot, processName string) bool {
+	processRoot := filepath.Join(procRoot, processName)
+	comm, err := os.ReadFile(filepath.Join(processRoot, "comm"))
+	if err != nil || !isAndroidSystemResolverThreadName(strings.TrimSpace(string(comm)), processName) {
+		return false
+	}
+	status, err := os.ReadFile(filepath.Join(processRoot, "status"))
+	if err != nil || !hasRootUID(status) {
+		return false
+	}
+	commandLine, err := os.ReadFile(filepath.Join(processRoot, "cmdline"))
+	if err != nil {
+		return false
+	}
+	command := strings.SplitN(string(commandLine), "\x00", 2)[0]
+	executable, executableErr := os.Readlink(filepath.Join(processRoot, "exe"))
+	return isAndroidSystemResolverExecutable(command, executable, executableErr)
+}
+
+func isAndroidSystemResolverExecutable(command, executable string, executableErr error) bool {
+	if filepath.Base(command) != "netd" {
+		return false
+	}
+	if executableErr == nil {
+		return filepath.Base(strings.TrimSuffix(executable, " (deleted)")) == "netd"
+	}
+	return isPermissionError(executableErr) && isTrustedAndroidSystemResolverCommand(command)
+}
+
+func isPermissionError(err error) bool {
+	return errors.Is(err, os.ErrPermission) || errors.Is(err, unix.EPERM) || errors.Is(err, unix.EACCES)
+}
+func isTrustedAndroidSystemResolverCommand(command string) bool {
+	command = filepath.Clean(command)
+	switch command {
+	case "/system/bin/netd", "/system_ext/bin/netd", "/product/bin/netd", "/vendor/bin/netd", "/odm/bin/netd":
+		return true
+	default:
+		return strings.HasPrefix(command, "/apex/") && strings.HasSuffix(command, "/bin/netd")
+	}
+}
+
+func isAndroidSystemResolverThreadName(threadName, processName string) bool {
+	threadName = strings.ToLower(threadName)
+	if threadName == "netd" || threadName == "binder:netd" {
+		return true
+	}
+	threadIndex, found := strings.CutPrefix(threadName, "binder:"+processName+"_")
+	if !found || threadIndex == "" {
+		return false
+	}
+	_, err := strconv.ParseUint(threadIndex, 10, 32)
+	return err == nil
+}
+
+func hasRootUID(status []byte) bool {
+	for _, line := range strings.Split(string(status), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) >= 2 && fields[0] == "Uid:" {
+			return fields[1] == "0"
+		}
+	}
+	return false
+}
+
+func (b *CgroupBackend) replaceAndroidSystemResolverTGIDs(next map[uint32]struct{}) error {
+	if b == nil {
+		return errBackendClosed
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return err
+	}
+	mapInstance := b.runtime.maps["cgroup_system_resolver_tgid"]
+	if mapInstance == nil {
+		if len(next) == 0 {
+			return nil
+		}
+		return E.New("Android system resolver map is unavailable")
+	}
+	additions := make([]uint32, 0, len(next))
+	for tgid := range next {
+		if _, loaded := b.systemResolverTGIDs[tgid]; !loaded {
+			additions = append(additions, tgid)
+		}
+	}
+	removals := make([]uint32, 0, len(b.systemResolverTGIDs))
+	for tgid := range b.systemResolverTGIDs {
+		if _, loaded := next[tgid]; !loaded {
+			removals = append(removals, tgid)
+		}
+	}
+	added, removed, updateErr := replaceUint32SetMap(mapInstance, additions, removals)
+	if updateErr != nil {
+		rollbackErr := rollbackUint32SetMap(mapInstance, added, removed)
+		err := policyUpdateError(updateErr, rollbackErr)
+		if policyRollbackFailed(err) {
+			return E.Errors(err, b.health.invalidate("cgroup", "Android system resolver TGID"))
+		}
+		return err
+	}
+	b.systemResolverTGIDs = cloneUint32Set(next)
+	return nil
+}
+
+func replaceUint32SetMap(mapInstance *CiliumEBPF.Map, additions, removals []uint32) ([]uint32, []uint32, error) {
+	if mapInstance == nil {
+		return nil, nil, errBackendClosed
+	}
+	value := uint8(1)
+	added := make([]uint32, 0, len(additions))
+	for _, key := range additions {
+		if err := updateMapWithFlags(mapInstance.FD(), unsafe.Pointer(&key), unsafe.Pointer(&value), bpfNoExist); err != nil {
+			if errors.Is(err, unix.EEXIST) || errors.Is(err, CiliumEBPF.ErrKeyExist) {
+				continue
+			}
+			return added, nil, err
+		}
+		added = append(added, key)
+	}
+	removed := make([]uint32, 0, len(removals))
+	for _, key := range removals {
+		if err := deleteMap(mapInstance.FD(), unsafe.Pointer(&key)); err != nil {
+			if errors.Is(err, unix.ENOENT) || errors.Is(err, CiliumEBPF.ErrKeyNotExist) {
+				continue
+			}
+			return added, removed, err
+		}
+		removed = append(removed, key)
+	}
+	return added, removed, nil
+}
+
+func rollbackUint32SetMap(mapInstance *CiliumEBPF.Map, added, removed []uint32) error {
+	if mapInstance == nil {
+		return errBackendClosed
+	}
+	value := uint8(1)
+	var rollbackErr error
+	for _, key := range removed {
+		if err := updateMap(mapInstance.FD(), unsafe.Pointer(&key), unsafe.Pointer(&value)); err != nil {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	for _, key := range added {
+		if err := deleteMap(mapInstance.FD(), unsafe.Pointer(&key)); err != nil &&
+			!errors.Is(err, unix.ENOENT) && !errors.Is(err, CiliumEBPF.ErrKeyNotExist) {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	return rollbackErr
+}
+
+func cloneUint32Set(source map[uint32]struct{}) map[uint32]struct{} {
+	cloned := make(map[uint32]struct{}, len(source))
+	for value := range source {
+		cloned[value] = struct{}{}
+	}
+	return cloned
+}
+
+func (b *CgroupBackend) startAndroidSystemResolverMonitor() {
+	if b == nil || !androidSystemResolverRequired() || b.systemResolverTGIDMapFD < 0 {
+		return
+	}
+	b.systemResolverMonitorAccess.Lock()
+	defer b.systemResolverMonitorAccess.Unlock()
+	if b.systemResolverMonitorStop != nil {
+		return
+	}
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	b.systemResolverMonitorStop = stop
+	b.systemResolverMonitorDone = done
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(androidSystemResolverRefreshInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stop:
+				return
+			case <-ticker.C:
+				next, err := discoverAndroidSystemResolverTGIDs(true)
+				if err == nil {
+					_ = b.replaceAndroidSystemResolverTGIDs(next)
+				}
+			}
+		}
+	}()
+}
+
+func (b *CgroupBackend) stopAndroidSystemResolverMonitor() {
+	if b == nil {
+		return
+	}
+	b.systemResolverMonitorAccess.Lock()
+	defer b.systemResolverMonitorAccess.Unlock()
+	if b.systemResolverMonitorStop == nil {
+		return
+	}
+	close(b.systemResolverMonitorStop)
+	<-b.systemResolverMonitorDone
+	b.systemResolverMonitorStop = nil
+	b.systemResolverMonitorDone = nil
+}
+
+func (b *CgroupBackend) AndroidSystemResolverStatus() (AndroidSystemResolverStatus, error) {
+	if b == nil {
+		return AndroidSystemResolverStatus{}, errBackendClosed
+	}
+	b.access.RLock()
+	defer b.access.RUnlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return AndroidSystemResolverStatus{}, err
+	}
+	status := AndroidSystemResolverStatus{
+		Required:   b.runtime.system_resolver,
+		Discovered: len(b.systemResolverTGIDs),
+	}
+	var err error
+	status.PlainDNS, err = b.readCgroupStatLocked(cgroupStatResolverDNS)
+	if err == nil {
+		status.DNSOverTLS, err = b.readCgroupStatLocked(cgroupStatResolverTLS)
+	}
+	if err == nil {
+		status.DNSOverHTTPS, err = b.readCgroupStatLocked(cgroupStatResolverHTTPS)
+	}
+	return status, err
+}
