diff --git a/common/ebpf/android_system_resolver_cgo.go b/common/ebpf/android_system_resolver_cgo.go
new file mode 100644
index 00000000..b6dc5bb3
--- /dev/null
+++ b/common/ebpf/android_system_resolver_cgo.go
@@ -0,0 +1,224 @@
+//go:build with_ebpf && (linux || android) && cgo
+
+package ebpf
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+	"unsafe"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	androidSystemResolverRefreshInterval = 2 * time.Second
+	maxAndroidSystemResolverTGIDs        = 16
+)
+
+func discoverAndroidSystemResolverTGIDs(enabled bool) (map[uint32]struct{}, error) {
+	result := make(map[uint32]struct{})
+	if !enabled {
+		return result, nil
+	}
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil, err
+	}
+	for _, entry := range entries {
+		pid, parseErr := strconv.ParseUint(entry.Name(), 10, 32)
+		if parseErr != nil || !isAndroidSystemResolverProcess("/proc", entry.Name()) {
+			continue
+		}
+		result[uint32(pid)] = struct{}{}
+		if len(result) > maxAndroidSystemResolverTGIDs {
+			return nil, fmt.Errorf("too many Android netd processes")
+		}
+	}
+	return result, nil
+}
+
+func isAndroidSystemResolverProcess(procRoot string, processName string) bool {
+	processRoot := filepath.Join(procRoot, processName)
+	comm, err := os.ReadFile(filepath.Join(processRoot, "comm"))
+	if err != nil {
+		return false
+	}
+	threadName := strings.TrimSpace(string(comm))
+	if !isAndroidSystemResolverThreadName(threadName, processName) {
+		return false
+	}
+	status, err := os.ReadFile(filepath.Join(processRoot, "status"))
+	if err != nil || !hasRootUID(status) {
+		return false
+	}
+	executable, err := os.Readlink(filepath.Join(processRoot, "exe"))
+	if err != nil || filepath.Base(strings.TrimSuffix(executable, " (deleted)")) != "netd" {
+		return false
+	}
+	commandLine, err := os.ReadFile(filepath.Join(processRoot, "cmdline"))
+	if err != nil {
+		return false
+	}
+	command := strings.SplitN(string(commandLine), "\x00", 2)[0]
+	return filepath.Base(command) == "netd"
+}
+
+func isAndroidSystemResolverThreadName(threadName string, processName string) bool {
+	if threadName == "netd" || threadName == "Binder:netd" {
+		return true
+	}
+	threadIndex, found := strings.CutPrefix(threadName, "binder:"+processName+"_")
+	if !found || threadIndex == "" {
+		return false
+	}
+	_, err := strconv.ParseUint(threadIndex, 10, 32)
+	return err == nil
+}
+
+func hasRootUID(status []byte) bool {
+	for _, line := range strings.Split(string(status), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) >= 2 && fields[0] == "Uid:" {
+			return fields[1] == "0"
+		}
+	}
+	return false
+}
+
+func (b *CgroupBackend) replaceAndroidSystemResolverTGIDs(next map[uint32]struct{}) error {
+	if b == nil {
+		return errBackendClosed
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	if err := b.health.requireUsable(b.runtime != nil); err != nil {
+		return err
+	}
+	if b.systemResolverTGIDMapFD < 0 {
+		if len(next) != 0 {
+			return E.New("Android system resolver map is unavailable")
+		}
+		return nil
+	}
+	additions := make([]uint32, 0, len(next))
+	for tgid := range next {
+		if _, present := b.systemResolverTGIDs[tgid]; !present {
+			additions = append(additions, tgid)
+		}
+	}
+	removals := make([]uint32, 0, len(b.systemResolverTGIDs))
+	for tgid := range b.systemResolverTGIDs {
+		if _, present := next[tgid]; !present {
+			removals = append(removals, tgid)
+		}
+	}
+	added, removed, updateErr := replaceUint32SetMap(b.systemResolverTGIDMapFD, additions, removals)
+	if updateErr != nil {
+		rollbackErr := rollbackUint32SetMap(b.systemResolverTGIDMapFD, added, removed)
+		err := policyUpdateError(updateErr, rollbackErr)
+		if policyRollbackFailed(err) {
+			return E.Errors(err, b.health.invalidate("cgroup", "Android system resolver TGID"))
+		}
+		return err
+	}
+	b.systemResolverTGIDs = cloneUint32Set(next)
+	return nil
+}
+
+func replaceUint32SetMap(mapFD int, additions, removals []uint32) ([]uint32, []uint32, error) {
+	value := uint8(1)
+	added := make([]uint32, 0, len(additions))
+	for _, key := range additions {
+		if err := updateMapWithFlags(mapFD, unsafe.Pointer(&key), unsafe.Pointer(&value), bpfNoExist); err != nil {
+			if errors.Is(err, unix.EEXIST) {
+				continue
+			}
+			return added, nil, err
+		}
+		added = append(added, key)
+	}
+	removed := make([]uint32, 0, len(removals))
+	for _, key := range removals {
+		if err := deleteMap(mapFD, unsafe.Pointer(&key)); err != nil {
+			if errors.Is(err, unix.ENOENT) {
+				continue
+			}
+			return added, removed, err
+		}
+		removed = append(removed, key)
+	}
+	return added, removed, nil
+}
+
+func rollbackUint32SetMap(mapFD int, added, removed []uint32) error {
+	value := uint8(1)
+	var rollbackErr error
+	for _, key := range removed {
+		if err := updateMap(mapFD, unsafe.Pointer(&key), unsafe.Pointer(&value)); err != nil {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	for _, key := range added {
+		if err := deleteMap(mapFD, unsafe.Pointer(&key)); err != nil && !errors.Is(err, unix.ENOENT) {
+			rollbackErr = E.Errors(rollbackErr, err)
+		}
+	}
+	return rollbackErr
+}
+
+func cloneUint32Set(source map[uint32]struct{}) map[uint32]struct{} {
+	cloned := make(map[uint32]struct{}, len(source))
+	for value := range source {
+		cloned[value] = struct{}{}
+	}
+	return cloned
+}
+
+func (b *CgroupBackend) startAndroidSystemResolverMonitorLocked() {
+	b.systemResolverMonitorMu.Lock()
+	defer b.systemResolverMonitorMu.Unlock()
+	if !b.includeAndroidSystemResolver || b.systemResolverTGIDMapFD < 0 || b.systemResolverStop != nil {
+		return
+	}
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	b.systemResolverStop = stop
+	b.systemResolverDone = done
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(androidSystemResolverRefreshInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stop:
+				return
+			case <-ticker.C:
+				next, err := discoverAndroidSystemResolverTGIDs(true)
+				if err == nil && len(next) != 0 {
+					_ = b.replaceAndroidSystemResolverTGIDs(next)
+				}
+			}
+		}
+	}()
+}
+
+func (b *CgroupBackend) stopAndroidSystemResolverMonitor() {
+	if b == nil {
+		return
+	}
+	b.systemResolverMonitorMu.Lock()
+	defer b.systemResolverMonitorMu.Unlock()
+	if b.systemResolverStop == nil {
+		return
+	}
+	close(b.systemResolverStop)
+	<-b.systemResolverDone
+	b.systemResolverStop = nil
+	b.systemResolverDone = nil
+}
